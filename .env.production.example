# Valori per il database REMOTO usato su Vercel. Copia questo file in .env.production
# (è ignorato da git) SOLO per eseguire dal tuo PC:
#   npm run db:migrate:remoto      (crea/aggiorna le tabelle)
#   npm run admin:create:remoto    (crea il primo amministratore)
# Gli stessi valori vanno inseriti anche in Vercel → Settings → Environment Variables.
# Non committare mai valori reali.

NODE_ENV=production
APP_ORIGIN=https://il-tuo-progetto.vercel.app

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# true = connessione cifrata (obbligatoria con i database in cloud)
DB_SSL=true
# Facoltativo: certificato CA del provider, in una riga con \n al posto degli a capo
DB_SSL_CA=
DB_CONNECTION_LIMIT=3

# Stringa casuale (>= 32 caratteri): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Stringa casuale (>= 16 caratteri): Vercel la invia come Bearer alla manutenzione periodica
CRON_SECRET=

# Creati da Vercel quando colleghi lo store Blob (privato) al progetto, con il prefisso predefinito BLOB:
# BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (autenticazione OIDC) oppure BLOB_READ_WRITE_TOKEN.
# Non servono sul tuo PC: servono solo in Vercel.

GEOCODING_ENABLED=true
GEOCODING_EMAIL=
# Moduli IA: regole (filtri a regole) | cloudflare o mistral (in più un modello linguistico nel worker) | nessuno
AI_PROVIDER=regole
# Livello successivo se il primario non risponde: groq | cloudflare (secondo servizio) | regole | nessuno
# (Groq elabora i dati fuori dall'UE; vedi docs/AI-PROVIDERS.md e docs/GUIDA-TEST-IA.md)
AI_FALLBACK_PROVIDER=regole
# Le chiavi si impostano solo qui (o nel pannello Vercel, come Secret), mai nel codice. Dove prenderle: docs/CONFIGURAZIONE-IA.md
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Attesa massima di una risposta (ms) e nuovi tentativi su 429, 5xx e timeout
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Richieste al minuto, richieste al giorno e token al giorno per provider (0 = nessun limite).
# Oltre il limite si passa al livello successivo o il job si rimanda. Contatori del giorno: tabella ai_quota.
# Valori prudenti: tienili sotto i limiti letti nella console di ciascun fornitore.
# Valori per un solo provider: CLOUDFLARE_MAX_RPM, CLOUDFLARE_MAX_RPD, CLOUDFLARE_MAX_TPD, GROQ_MAX_RPM, GROQ_MAX_RPD,
# GROQ_MAX_TPD, MISTRAL_MAX_RPM, MISTRAL_MAX_RPD, MISTRAL_MAX_TPD
AI_MAX_RPM=20
AI_MAX_RPD=500
AI_MAX_TPD=100000
# Moderazione automatica: nasconde le segnalazioni con esito BLOCCATO (false = solo suggerimenti al comitato)
AI_AUTO_NASCONDI=true
# Confidenza minima (0-1) per nascondere spam, testi privi di senso o non pertinenti
AI_SOGLIA_AUTO_NASCONDI=0.9
# Verifica di autenticità: distanza massima (metri) tra la posizione GPS della foto e quella della segnalazione
EXIF_MAX_DISTANCE_M=100
# Su Vercel non c'è un worker in sottofondo: le analisi partono dopo ogni invio
AI_WORKER_INTERVAL_MS=0
# Job elaborati al massimo per invocazione (la funzione dura al massimo 60 s)
AI_JOB_PER_RUN=5
RATE_LIMIT_ENABLED=true
