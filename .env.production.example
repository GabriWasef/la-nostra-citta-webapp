# Valori per il database REMOTO usato su Vercel. Copia questo file in .env.production
# (è ignorato da git) SOLO per eseguire dal tuo PC:
#   npm run db:migrate:remoto      (crea/aggiorna le tabelle)
#   npm run admin:create:remoto    (crea il primo amministratore)
# Gli stessi valori vanno inseriti anche in Vercel → Settings → Environment Variables.
# Non committare mai valori reali.

NODE_ENV=production
APP_ORIGIN=https://il-tuo-progetto.vercel.app

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# true = connessione cifrata (obbligatoria con i database in cloud)
DB_SSL=true
# Facoltativo: certificato CA del provider, in una riga con \n al posto degli a capo
DB_SSL_CA=
DB_CONNECTION_LIMIT=3

# Stringa casuale (>= 32 caratteri): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Stringa casuale (>= 16 caratteri): Vercel la invia come Bearer alla manutenzione periodica
CRON_SECRET=

# Creati da Vercel quando colleghi lo store Blob (privato) al progetto, con il prefisso predefinito BLOB:
# BLOB_STORE_ID + BLOB_WEBHOOK_PUBLIC_KEY (autenticazione OIDC) oppure BLOB_READ_WRITE_TOKEN.
# Non servono sul tuo PC: servono solo in Vercel.

GEOCODING_ENABLED=true
GEOCODING_EMAIL=
AI_PROVIDER=regole
# Modello linguistico (solo con AI_PROVIDER=mistral; vedi docs/AI-PROVIDERS.md).
# Fallback: groq (secondo servizio, elabora i dati fuori dall'UE) | regole | nessuno
AI_FALLBACK_PROVIDER=regole
# Le chiavi si impostano solo qui (o nel pannello Vercel), mai nel codice.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Attesa massima di una risposta (ms) e nuovi tentativi su 429, 5xx e timeout
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Su Vercel non c'è un worker in sottofondo: le analisi partono dopo ogni invio
AI_WORKER_INTERVAL_MS=0
# Job elaborati al massimo per invocazione (la funzione dura al massimo 60 s)
AI_JOB_PER_RUN=5
RATE_LIMIT_ENABLED=true
