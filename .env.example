# Copia questo file in .env e inserisci i valori reali. Non committare mai .env.

# Ambiente: development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Indirizzo pubblico della webapp (usato per il controllo dell'header Origin)
APP_ORIGIN=http://localhost:3000
# Altri client autorizzati (es. futura app), separati da virgola. Vuoto = nessun CORS.
CORS_ORIGINS=
# true se l'app è dietro un reverse proxy HTTPS (nginx, Traefik...)
TRUST_PROXY=false

# Database MySQL 8.0+ (con docker compose il servizio app usa automaticamente DB_HOST=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lnc_app
DB_PASSWORD=cambia-questa-password
DB_NAME=la_nostra_citta
DB_CONNECTION_LIMIT=10
# Database usato da npm test (verrà SVUOTATO a ogni esecuzione)
TEST_DB_NAME=la_nostra_citta_test

# Sessioni: stringa casuale di almeno 32 caratteri
# (generabile con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8

# Allegati
UPLOAD_DIR=uploads
MAX_FILES=5
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50

# Ricerca degli indirizzi sulla mappa (Nominatim di OpenStreetMap, gratuito, senza chiave).
# Il server rispetta il limite di 1 richiesta al secondo e conserva i risultati in cache.
GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org
# Facoltativo: e-mail di contatto inviata a Nominatim (consigliata se l'uso cresce)
GEOCODING_EMAIL=

# Moduli IA: regole (filtri a regole) | cloudflare o mistral (in più un modello linguistico nel worker) | nessuno
AI_PROVIDER=regole
# Livello successivo se il primario non risponde: groq | cloudflare (secondo servizio) | regole | nessuno
# (Groq elabora i dati fuori dall'UE; vedi docs/AI-PROVIDERS.md e docs/GUIDA-TEST-IA.md)
AI_FALLBACK_PROVIDER=regole
# Le chiavi si impostano solo qui (o nel pannello Vercel, come Secret), mai nel codice. Dove prenderle: docs/CONFIGURAZIONE-IA.md
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Attesa massima di una risposta (ms) e nuovi tentativi su 429, 5xx e timeout
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Richieste al minuto, richieste al giorno e token al giorno per provider (0 = nessun limite).
# Oltre il limite si passa al livello successivo o il job si rimanda. Contatori del giorno: tabella ai_quota.
# Valori prudenti: tienili sotto i limiti letti nella console di ciascun fornitore.
# Valori per un solo provider: CLOUDFLARE_MAX_RPM, CLOUDFLARE_MAX_RPD, CLOUDFLARE_MAX_TPD, GROQ_MAX_RPM, GROQ_MAX_RPD,
# GROQ_MAX_TPD, MISTRAL_MAX_RPM, MISTRAL_MAX_RPD, MISTRAL_MAX_TPD
AI_MAX_RPM=20
AI_MAX_RPD=500
AI_MAX_TPD=100000
# Moderazione automatica: nasconde le segnalazioni con esito BLOCCATO (false = solo suggerimenti al comitato)
AI_AUTO_NASCONDI=true
# Confidenza minima (0-1) per nascondere spam, testi privi di senso o non pertinenti
AI_SOGLIA_AUTO_NASCONDI=0.9
# Verifica di autenticità: distanza massima (metri) tra la posizione GPS della foto e quella della segnalazione
EXIF_MAX_DISTANCE_M=100
# Intervallo del worker IA integrato nel server, in ms (0 = disattivato; usare npm run worker)
AI_WORKER_INTERVAL_MS=5000
# Job di analisi elaborati al massimo per ogni giro del worker
AI_JOB_PER_RUN=5

RATE_LIMIT_ENABLED=true

# Facoltative: se assenti si usano i valori indicati o si rilevano in automatico (vedi server/src/config/env.js)
# DB_SSL=false                  connessione cifrata al database (true per quasi tutti i MySQL in cloud)
# DB_SSL_CA=                    certificato della CA del provider, solo se non è una CA pubblica
# DB_SSL_CA_FILE=server/certs/db-ca.pem   file PEM con la CA (ha la precedenza su DB_SSL_CA se esiste)
# STORAGE_DRIVER=locale         locale | blob (blob se ci sono le variabili di Vercel Blob)
# ALLEGATI_LINK_MINUTI=15       durata dei link firmati agli allegati su Vercel Blob
# RATE_LIMIT_STORE=memoria      memoria | mysql (mysql su Vercel)
# CRON_SECRET=                  chiave della manutenzione periodica; senza, l'endpoint è disattivato
LOG_LEVEL=info

# Solo per npm run db:seed:demo (password degli utenti dimostrativi)
SEED_DEMO_PASSWORD=
