# Copia questo file in .env e inserisci i valori reali. Non committare mai .env.

# Ambiente: development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Indirizzo pubblico della webapp (usato per il controllo dell'header Origin)
APP_ORIGIN=http://localhost:3000
# Altri client autorizzati (es. futura app), separati da virgola. Vuoto = nessun CORS.
CORS_ORIGINS=
# true se l'app è dietro un reverse proxy HTTPS (nginx, Traefik...)
TRUST_PROXY=false

# Database MySQL 8.0+ (con docker compose il servizio app usa automaticamente DB_HOST=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lnc_app
DB_PASSWORD=cambia-questa-password
DB_NAME=la_nostra_citta
DB_CONNECTION_LIMIT=10
# Database usato da npm test (verrà SVUOTATO a ogni esecuzione)
TEST_DB_NAME=la_nostra_citta_test

# Sessioni: stringa casuale di almeno 32 caratteri
# (generabile con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8

# Allegati
UPLOAD_DIR=uploads
MAX_FILES=5
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50

# Moduli IA: regole (filtri a regole inclusi nel progetto) | nessuno
AI_PROVIDER=regole
# Intervallo del worker IA integrato nel server, in ms (0 = disattivato; usare npm run worker)
AI_WORKER_INTERVAL_MS=5000

RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Solo per npm run db:seed:demo (password degli utenti dimostrativi)
SEED_DEMO_PASSWORD=
