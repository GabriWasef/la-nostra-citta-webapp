# Copia questo file in .env e inserisci i valori reali. Non committare mai .env.

# Ambiente: development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Indirizzo pubblico della webapp (usato per il controllo dell'header Origin)
APP_ORIGIN=http://localhost:3000
# Altri client autorizzati (es. futura app), separati da virgola. Vuoto = nessun CORS.
CORS_ORIGINS=
# true se l'app è dietro un reverse proxy HTTPS (nginx, Traefik...)
TRUST_PROXY=false

# Database MySQL 8.0+ (con docker compose il servizio app usa automaticamente DB_HOST=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lnc_app
DB_PASSWORD=cambia-questa-password
DB_NAME=la_nostra_citta
DB_CONNECTION_LIMIT=10
# Database usato da npm test (verrà SVUOTATO a ogni esecuzione)
TEST_DB_NAME=la_nostra_citta_test

# Sessioni: stringa casuale di almeno 32 caratteri
# (generabile con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=8

# Allegati
UPLOAD_DIR=uploads
MAX_FILES=5
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50

# Ricerca degli indirizzi sulla mappa (Nominatim di OpenStreetMap, gratuito, senza chiave).
# Il server rispetta il limite di 1 richiesta al secondo e conserva i risultati in cache.
GEOCODING_ENABLED=true
GEOCODING_URL=https://nominatim.openstreetmap.org
# Facoltativo: e-mail di contatto inviata a Nominatim (consigliata se l'uso cresce)
GEOCODING_EMAIL=

# Moduli IA: regole (filtri a regole inclusi nel progetto) | mistral (in più un modello linguistico) | nessuno
AI_PROVIDER=regole
# Modello linguistico (solo con AI_PROVIDER=mistral; vedi docs/AI-PROVIDERS.md).
# Fallback: groq (secondo servizio, elabora i dati fuori dall'UE) | regole | nessuno
AI_FALLBACK_PROVIDER=regole
# Le chiavi si impostano solo qui (o nel pannello Vercel), mai nel codice.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Attesa massima di una risposta (ms) e nuovi tentativi su 429, 5xx e timeout
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
# Richieste al minuto e al giorno per provider (0 = nessun limite); oltre il limite il job si rimanda.
# Valori per un solo provider: MISTRAL_MAX_RPM, MISTRAL_MAX_RPD, GROQ_MAX_RPM, GROQ_MAX_RPD
AI_MAX_RPM=20
AI_MAX_RPD=500
# Verifica di autenticità: distanza massima (metri) tra la posizione GPS della foto e quella della segnalazione
EXIF_MAX_DISTANCE_M=100
# Intervallo del worker IA integrato nel server, in ms (0 = disattivato; usare npm run worker)
AI_WORKER_INTERVAL_MS=5000
# Job di analisi elaborati al massimo per ogni giro del worker
AI_JOB_PER_RUN=5

RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Solo per npm run db:seed:demo (password degli utenti dimostrativi)
SEED_DEMO_PASSWORD=
